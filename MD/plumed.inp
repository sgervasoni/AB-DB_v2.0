g1: GROUP ATOMS=1-XXXXX

rg1: GYRATION ATOMS=g1 TYPE=RADIUS
rg2: GYRATION ATOMS=g1 TYPE=RADIUS
rg3: GYRATION ATOMS=g1 TYPE=RADIUS
asp: GYRATION ATOMS=g1 TYPE=ASPHERICITY
acy: GYRATION ATOMS=g1 TYPE=ACYLINDRICITY
kap: GYRATION ATOMS=g1 TYPE=KAPPA2

PRINT ARG=rg1,rg2,rg3,asp,acy,kap STRIDE=10 FILE=COLVAR
